# ============================================================================
# Gmail Campaign Mailer - PRODUCTION environment reference
#
# This file is NOT meant to be copied to .env and filled in - production
# secrets are never stored in a file at all (see requirement 6 in
# ENVIRONMENT.md). It exists purely as a checklist of every variable that
# must be set in your hosting provider's environment variable dashboard
# (Render -> Service -> Environment, for both the "web" and "worker"
# services), with the value each one should hold in production.
#
# Set these identically on BOTH the API service and the worker service unless
# noted otherwise - a mismatch (e.g. different EMAIL_TOKEN_ENCRYPTION_KEY)
# silently breaks the app. See ENVIRONMENT.md for the full explanation of
# each variable.
# ============================================================================

# --- Google OAuth / Gmail API ------------------------------------------------
# A PRODUCTION Google OAuth client (separate from your dev client), with the
# production OAUTH_REDIRECT_URI below added to its "Authorized redirect URIs".
GOOGLE_CLIENT_ID = "<production-client-id>.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "<production-client-secret>"
OAUTH_REDIRECT_URI = "https://<your-api-domain>/auth/callback"

# --- Credential encryption ---------------------------------------------------
# REQUIRED in production (never leave empty - do not rely on the auto-generated
# dev fallback). Generate once, set identically on the API and worker services:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_TOKEN_ENCRYPTION_KEY = "<generated-fernet-key>"

# --- Campaign attachments -----------------------------------------------------
# Supabase Storage bucket, shared by the web service and the worker - set the
# same value on both. Auto-created on startup if missing.
ATTACHMENTS_BUCKET = "campaign-attachments"

# --- Redis queue + worker -----------------------------------------------------
# A PRODUCTION Redis instance (e.g. Upstash), separate from any dev/staging
# instance, so dev jobs and prod jobs never share a queue.
REDIS_URL = "rediss://<upstash-production-url>"
CAMPAIGN_QUEUE = "campaigns"
SEND_DELAY_MIN = 30
SEND_DELAY_MAX = 75
SEND_RETRY_DELAY = 10
MAX_SEND_ATTEMPTS = 2
DAILY_EMAIL_QUOTA = 50

# --- Supabase ------------------------------------------------------------------
# A PRODUCTION Supabase project, separate from dev, with its own RLS-protected
# tables and its own real users.
SUPABASE_URL = "https://<production-project-ref>.supabase.co"
SUPABASE_ANON_KEY = "<production-anon-key>"
SUPABASE_SERVICE_ROLE_KEY = "<production-service-role-key>"
SUPABASE_JWT_SECRET = "<production-jwt-secret>"

# --- Web UI / CORS ---------------------------------------------------------------
# Your deployed frontend's real origin(s) only - do not leave localhost in the
# production CORS_ORIGINS list.
CORS_ORIGINS = "https://<your-frontend-domain>"
FRONTEND_URL = "https://<your-frontend-domain>"

# --- Subscriptions / admin ----------------------------------------------------
ADMIN_EMAIL = "<real-admin-email>"
TRIAL_DAYS = 14

# ============================================================================
# Frontend (gmail-campaign-mailer-ui repo, set in Vercel -> Project ->
# Settings -> Environment Variables for the Production environment):
#
#   VITE_SUPABASE_URL        = same production Supabase project URL as above
#   VITE_SUPABASE_ANON_KEY   = same production Supabase anon key as above
#   VITE_API_BASE_URL        = https://<your-api-domain>
# ============================================================================
