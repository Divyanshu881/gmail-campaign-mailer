# ============================================================================
# Gmail Campaign Mailer - environment template (LOCAL DEVELOPMENT)
#
# Copy this file to .env and fill in real values for YOUR OWN local dev setup
# (your own Google OAuth client, your own Supabase project, local Redis).
#   cp .env.example .env
#
# This file must never contain real secrets - only placeholders. The real
# .env is gitignored and never committed.
#
# In production (Render/Vercel/etc.) these values are NOT read from a file at
# all - they are set directly in the hosting provider's environment variable
# dashboard. See .env.production.example and ENVIRONMENT.md for the
# production variant of every variable below.
# ============================================================================

# --- Google OAuth / Gmail API -------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID.
# Use a SEPARATE OAuth client for dev vs prod (different redirect URIs), or at
# least make sure both http://localhost:8000/auth/callback and your production
# callback URL are both listed under "Authorized redirect URIs" on the client
# you use.
GOOGLE_CLIENT_ID = "your-dev-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "your-dev-client-secret"

# Must EXACTLY match one of the "Authorized redirect URIs" configured above.
# DIFFERS IN PRODUCTION (points at your deployed backend, not localhost).
OAUTH_REDIRECT_URI = "http://localhost:8000/auth/callback"

# --- Credential encryption ----------------------------------------------------
# Fernet key used to encrypt Gmail OAuth tokens stored in the `email_connections`
# table. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty, the app auto-generates one and writes it to ENCRYPTION_KEY_FILE
# for local dev convenience only. MUST be explicitly set (and identical across
# every backend/worker instance) in production - see ENVIRONMENT.md.
EMAIL_TOKEN_ENCRYPTION_KEY = ""

# Where the auto-generated dev encryption key is persisted when
# EMAIL_TOKEN_ENCRYPTION_KEY is empty. Local dev only; gitignored.
ENCRYPTION_KEY_FILE = "encryption.key"

# --- Campaign attachments -----------------------------------------------------
# Local directory for uploaded campaign attachments (gitignored). Fine for a
# single-process local dev setup; NOT suitable as-is if the API and worker run
# as separate production services with no shared filesystem (see ENVIRONMENT.md).
UPLOAD_DIR = "uploads"

# --- Redis queue + worker -----------------------------------------------------
# Local Redis: redis://localhost:6379/0 (macOS: brew install redis && redis-server).
# DIFFERS IN PRODUCTION: an Upstash (or other managed) redis://.../rediss://.../
# URL - use a SEPARATE Redis database/instance per environment so a dev worker
# can never consume a production campaign's queued job, or vice versa.
REDIS_URL = "redis://localhost:6379/0"

# Redis list name the worker reads (BLPOP) and /start writes to.
CAMPAIGN_QUEUE = "campaigns"

# Rate limiting between emails: a random delay within this range, in seconds.
# This is throttling to avoid bursts, NOT a guarantee of inbox placement.
SEND_DELAY_MIN = 30
SEND_DELAY_MAX = 75

# Seconds to wait before retrying a failed email.
SEND_RETRY_DELAY = 10

# Total send attempts per contact (1 initial + 1 retry = 2).
MAX_SEND_ATTEMPTS = 2

# Fallback daily cap per user, only used when a user has no subscription row
# (subscriptions.daily_email_limit is the real limit once one exists).
DAILY_EMAIL_QUOTA = 50

# --- Supabase ------------------------------------------------------------------
# Use a SEPARATE Supabase project for dev vs prod so test data, test users,
# and test emails never touch production data.
#
# Project Settings -> API -> Project URL
SUPABASE_URL = "https://your-dev-project-ref.supabase.co"

# Project Settings -> API -> Project API keys -> anon public
# Safe to expose to a browser (used by the dev test page and the web UI).
SUPABASE_ANON_KEY = "your-dev-anon-key"

# Project Settings -> API -> Project API keys -> service_role
# SERVER-SIDE SECRET. Bypasses Row Level Security. Never expose to a browser
# or commit it anywhere.
SUPABASE_SERVICE_ROLE_KEY = "your-dev-service-role-key"

# Project Settings -> API -> JWT Settings -> JWT Secret
# Used by the backend to verify Supabase access tokens (HS256 projects only;
# newer ES256/RS256 projects are verified via JWKS instead and don't need this).
SUPABASE_JWT_SECRET = "your-dev-jwt-secret"

# --- Web UI / CORS ---------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
# DIFFERS IN PRODUCTION (your deployed frontend origin, e.g. Vercel URL).
CORS_ORIGINS = "http://localhost:5173,http://localhost:8000"

# Base URL of the React UI. Used to redirect the browser back after the Gmail
# OAuth flow (e.g. /auth/callback -> {FRONTEND_URL}/settings?auth=success).
# DIFFERS IN PRODUCTION.
FRONTEND_URL = "http://localhost:5173"

# --- Subscriptions / admin -------------------------------------------------------
# Email of the product owner/admin. Only this authenticated user can access
# /api/admin/subscriptions* endpoints (create/extend/cancel/list).
ADMIN_EMAIL = "admin@example.com"

# Free trial duration in days for new users (used only if/when
# create_trial_subscription() is wired into a signup flow).
TRIAL_DAYS = 14

# --- Legacy standalone SMTP mailer (mailer.py) ------------------------------
# Unrelated to the FastAPI app above - only used if you run `python mailer.py`
# directly (the original personal script this project was built from).
SENDER_EMAIL = ""
APP_PASSWORD = ""
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = 465

MIN_DELAY = 30
MAX_DELAY = 75
MAX_EMAILS = 50

DEFAULT_SUBJECT = "Hiring Support for {{Company_name}}"
DEFAULT_TEMPLATE = ""
